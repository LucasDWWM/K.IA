# K.IA - Configuration
# Copie ce fichier en ".env" et remplis les valeurs.

# --- Fournisseur LLM ---------------------------------------------------------
# anthropic | openrouter
PROVIDER=anthropic

# Cle Anthropic : https://console.claude.com -> API Keys
ANTHROPIC_API_KEY=
# Modele de conversation (streaming)
ANTHROPIC_MODEL=claude-sonnet-4-6
# Modele utilise pour consolider la memoire en fin de session.
# claude-haiku-4-5 suffit si tu veux reduire le cout.
MEMORY_MODEL=claude-opus-5

# OpenRouter (alternative gratuite pour tester)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-8b-instruct:free

# --- Memoire -----------------------------------------------------------------
# Dossier de stockage : topics.md + sessions/*.jsonl
# NB: ne pas mettre "./memory", ce nom est deja pris par le package Python.
MEMORY_DIR=./memory_store
# Nombre de tours de conversation rechargés dans le contexte
MEMORY_TURNS=10

# --- Synthese vocale (TTS) ---------------------------------------------------
TTS_PROVIDER=browser   # ou elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Divers ------------------------------------------------------------------
# Cle Google Maps (optionnelle, pour les itineraires)
MAPS_API_KEY=
